# WAREXX public website + interactive demo (landing-demo/).
# Copy to landing-demo/.env for local use, or set these on the host.
# Never commit .env.
#
# There is NO database setting here, on purpose: neither the landing page nor
# the demo has, needs or can use a database. The demo answers from the recorded
# sample business in demo-data/recorded. Nothing in landing-demo knows the
# production app's database URL, auth secret or API credentials — do not add them.
#
# Two kinds of variable, kept apart:
#
#   VITE_*   PUBLIC. Written into the pages at build time and readable by anyone.
#            Addresses only — NEVER a password, key, token or secret.
#   LEAD_*   SERVER-SIDE. Read only by the lead API (lead-api/, api/leads.py),
#            never by a build, never sent to a browser.

# ---------------------------------------------------------------------------
# Public addresses (build time)
# ---------------------------------------------------------------------------
# Unset = the defaults: localhost:8002 (demo) and localhost:8000 (app) in
# development; the values shown below in a production build. Uncomment to override.

# Where the landing page's forms are POSTed. "/api/leads" = this site's own
# lead API. Empty = no backend (forms show success and emit a browser event).
# VITE_LEAD_ENDPOINT=/api/leads

# The interactive demo. Default in a build: "/demo/", the demo on this same site
# (npm run build:site). Once the demo has a domain of its own, set it here:
# VITE_DEMO_URL=https://demo.warexx.aavoraa.com/

# The production WAREXX software, for the landing page's "Sign in".
# VITE_APP_URL=https://app.warexx.aavoraa.com/

# The payment page the pricing cards' "Subscribe" (Monthly / Annual) opens, with
# ?plan=monthly or ?plan=annual added. Empty (the default): Subscribe opens a
# plan enquiry form instead. Set it in Vercel's Environment Variables once the
# payment page exists, then redeploy.
# VITE_PAYMENT_URL=https://pay.warexx.aavoraa.com/subscribe

# The public site, for the demo's "Talk to us" when a visitor did not come from it.
# VITE_LANDING_URL=https://warexx.aavoraa.com

# ---------------------------------------------------------------------------
# Lead API (server-side only)
# ---------------------------------------------------------------------------
# console (default) saves each email as an .eml file under lead-api/outbox;
# smtp sends it.
LEAD_MAIL_BACKEND=console
LEAD_MAIL_FROM=WAREXX <sales@example.com>
LEAD_NOTIFY_TO=sales@example.com
LEAD_SMTP_HOST=smtpout.secureserver.net
LEAD_SMTP_PORT=465
LEAD_SMTP_USER=sales@example.com
LEAD_SMTP_PASSWORD=
# The free-trial email ("Your Free Trial Is Ready"): its support contact and
# signature. Default: the From address, and "WAREXX".
# LEAD_SUPPORT_EMAIL=support@example.com
# LEAD_COMPANY_NAME=WAREXX
# Only when the lead API is on a different host from the landing page:
# LEAD_ALLOWED_ORIGINS=https://warexx.aavoraa.com
# Local server (lead-api/server.py):
# LEAD_API_HOST=127.0.0.1
# LEAD_API_PORT=8003

# ---------------------------------------------------------------------------
# Demo trial: a booked slot → sign-up → two hours of the demo (server-side only)
# ---------------------------------------------------------------------------
# REQUIRED for the booked-slot sign-up on a deployment (Vercel: Project →
# Settings → Environment Variables). A long random value, e.g. the output of
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# It signs every sign-up pass; changing it signs everyone out. Without it the
# forms still send, and "Book a demo" opens the demo without a sign-up.
DEMO_TRIAL_SECRET=
# Window length in minutes, and the bookable slots (keep in step with
# demoSlots in frontend/landing/index.html):
# DEMO_TRIAL_MINUTES=120
# DEMO_SLOT_HOURS=10,12,15,17
# DEMO_SLOT_TZ_MINUTES=330
# DEMO_SLOT_DAYS=7
# Where the free-trial email's "Access Your Free Trial" button points (the demo,
# with the visitor's own expiring sign-up pass added). On Vercel it defaults to
# the project's production address + /demo/; set it when the demo has its own
# domain. Never built from the request's Host header (that could be forged).
# DEMO_PUBLIC_URL=https://demo.warexx.aavoraa.com/
