# landing-demo works as its own repository too, so it carries its own ignores.

# Secrets: only .env.example is tracked
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
frontend/dist/

# Demo-data authoring scratch: databases, the recorder's browser profile
demo-data/demo-build/
**/.record-profile/
*.orig

# The lead API's locally saved emails (contain visitors' details)
lead-api/outbox/

__pycache__/
*.pyc
.DS_Store
.vercel/

# The landing film's recorded video (~120 MB, over GitHub's 100 MB limit):
# copied in by tools/import-landing.mjs for local builds; host it and set
# VITE_DEMO_VIDEO_URL for deployments.
frontend/landing/assets/*.mp4

# The local leads database (lead-api/store.py without POSTGRES_URL): visitors' details
lead-api/data/
